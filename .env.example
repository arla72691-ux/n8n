# Gemini API key (used by langchain-google-genai)
GOOGLE_API_KEY=

# Google Drive — service account JSON file path OR inline JSON string
GOOGLE_DRIVE_DRAWINGS_FOLDER_ID=
GOOGLE_SERVICE_ACCOUNT_JSON=

# Langfuse observability
LANGFUSE_PUBLIC_KEY=
LANGFUSE_SECRET_KEY=
LANGFUSE_HOST=https://cloud.langfuse.com

# App
APP_ENV=development
LOG_LEVEL=INFO
